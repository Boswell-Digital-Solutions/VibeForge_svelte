{
  "name": "forge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "verify:artifact": "node scripts/verify-production-artifact.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:real-auth": "playwright test --project=real-auth",
    "test:e2e:report": "playwright show-report",
    "qc:stateforge": "bun run tools/qc/stateforge.ts",
    "generate:agent-instructions": "bun run tools/repo-context/generate-agent-instructions.ts",
    "check:agent-instruction-drift": "bun run tools/repo-context/check-agent-instruction-drift.ts",
    "verify:repo-context": "bun run tools/repo-context/verify-repo-context.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.13",
    "autoprefixer": "^10.4.22",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "svelte": "^5.43.10",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@types/marked": "^6.0.0",
    "chart.js": "^4.5.1",
    "highlight.js": "^11.11.1",
    "lucide-svelte": "^0.555.0",
    "marked": "^17.0.1",
    "monaco-editor": "^0.55.1",
    "svelte-chartjs": "^3.1.5"
  }
}
