# ============================================================================
# VibeForge Frontend Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual values.
# Frontend env vars must be prefixed with VITE_ to be exposed to the browser.

# ============================================================================
# Backend Service URLs
# ============================================================================
# VibeForge is a frontend-only application that consumes NeuroForge and
# DataForge APIs. All API calls go directly from browser to backend service.
#
# One variable configures one service. Set the origin only, with no path and no
# trailing slash. src/lib/core/api/endpoints.ts derives every versioned path and
# every websocket URL from these, so host and port cannot drift between them.
#
# Port assignments follow the Forge port registry:
#   :8000 — NeuroForge
#   :8001 — DataForge
#   :8002 — Rake
#
# These defaults match the registry, so a local stack on the standard ports
# needs no .env.local at all.

# NeuroForge: model routing, inference, authentication, insights.
# Also serves the MCP endpoint at /mcp and the inference websocket.
VITE_NEUROFORGE_URL=http://localhost:8000

# DataForge: durable records this application reads.
# Also serves the MCP endpoint at /mcp and the sync websocket at /ws.
VITE_DATAFORGE_URL=http://localhost:8001

# License validation.
# The default targets :8002, which the registry assigns to Rake, and no service
# in the ecosystem implements this route. The value is preserved rather than
# corrected, because which service owns license validation is an open question.
# See docs/KNOWN_ISSUES.md.
VITE_LICENSE_API_URL=http://localhost:8002/license

# API key for authenticating with backend services
VITE_VIBEFORGE_API_KEY=vf-dev-key

# ============================================================================
# Forge Public App Support Agent (local planning/integration only)
# ============================================================================
# This is not a VITE_ browser variable. It points local planning, agent-workcell,
# and support-suite tooling at the dedicated Forge Yellowjacket support repo.

FORGE_YELLOWJACKET_REPO_URL=git@github.com:Boswell-Digital-Solutions/forge-yellowjacket.git
FORGE_YELLOWJACKET_LOCAL_PATH=/home/charlie/Forge/apps/public-app-local-support/yellowjacket

# ============================================================================
# Optional: Backend Service Certificates
# ============================================================================
# For local development with self-signed certs, you may need:
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem

# ============================================================================
# Feature Flags
# ============================================================================
# No code reads any variable in this section or the next. They are declared
# only. See docs/KNOWN_ISSUES.md.

# Enable semantic search in context selector (requires DataForge)
VITE_ENABLE_CONTEXT_SEARCH=true

# Enable multi-model comparisons (requires NeuroForge)
VITE_ENABLE_MODEL_COMPARISON=true

# Enable run history (requires DataForge)
VITE_ENABLE_RUN_HISTORY=true

# ============================================================================
# Logging & Debugging
# ============================================================================

# Log API calls to console (development only)
VITE_LOG_API_CALLS=false

# Set to true to see integration debugging
VITE_DEBUG_INTEGRATION=false

# ============================================================================
# VibeForge Local Evidence Vault (src-tauri, Rust — not a VITE_ var)
# ============================================================================
# Local PostgreSQL vault used by the `vibeforge_vault` CLI (migrate/status/
# backup/restore/doctor). Start it with:
#   docker compose -f docker-compose.vault.yml up -d vault-db
# Default matches docker-compose.vault.yml; only set this if you're pointing
# at a different Postgres instance (e.g. the native cluster on 5432).

DATABASE_URL=postgres://forge:forge@localhost:5434/vibeforge
